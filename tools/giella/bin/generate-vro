#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
SHARE_DIR="${VRO_GIELLA_SHARE_DIR:-$REPO_ROOT/data/giella-share}"
LANG_CODE="${GIELLA_LANG:-vro}"

if [[ "${1:-}" == "--lang" && -n "${2:-}" ]]; then
  LANG_CODE="$2"
  shift 2
fi

if [[ "$LANG_CODE" == "vro" && -n "${VRO_GENERATOR_MODEL:-}" ]]; then
  MODEL="$VRO_GENERATOR_MODEL"
else
  MODEL="$SHARE_DIR/giella/$LANG_CODE/generator-gt-norm.hfstol"
fi

HFST_BIN="$(command -v hfst-optimized-lookup || true)"
if [[ -z "$HFST_BIN" && -x "$REPO_ROOT/../giellalt-south-estonian/.tools/apertium/bin/hfst-optimized-lookup" ]]; then
  HFST_BIN="$REPO_ROOT/../giellalt-south-estonian/.tools/apertium/bin/hfst-optimized-lookup"
fi

if [[ "${1:-}" == "--check" ]]; then
  [[ -n "$HFST_BIN" ]] || { echo "missing hfst-optimized-lookup" >&2; exit 1; }
  test -r "$MODEL" || { echo "missing generator model ($LANG_CODE): $MODEL" >&2; exit 1; }
  exit 0
fi

[[ -n "$HFST_BIN" ]] || { echo "missing hfst-optimized-lookup" >&2; exit 127; }

# Accept either a full analysis string or "lemma<TAB>tags".
while IFS= read -r line; do
  if [[ "$line" == *$'\t'* ]]; then
    lemma="${line%%$'\t'*}"
    tags="${line#*$'\t'}"
    printf '%s+%s\n' "$lemma" "$tags"
  else
    printf '%s\n' "$line"
  fi
done | "$HFST_BIN" -q "$MODEL"
